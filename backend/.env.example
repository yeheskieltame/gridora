# Gridora backend — copy to `.env` (gitignored) and PASTE your values. Never commit secrets.
# Loaded automatically at startup (config.py:_load_dotenv) — real env vars override these.

# ── Network ──────────────────────────────────────────────────────────────────
GRIDORA_TESTNET=true                 # true => chain key 'bsctestnet' (chainId 97)
GRIDORA_CHAIN_ID=97                  # 56 mainnet / 97 testnet (must match GRIDORA_TESTNET)
GRIDORA_BSC_RPC_URL=https://bsc-testnet.publicnode.com

# ── Trust Wallet Agent Kit (TWAK) auth — get from portal.trustwallet.com ───────
# `twak` reads these from the env after `twak init`; the gridora process passes them
# through to the `twak` CLI it spawns. PASTE your values:
TWAK_ACCESS_ID=                      # Trust Wallet Access ID
TWAK_HMAC_SECRET=                    # Trust Wallet HMAC Secret  (sensitive!)
TWAK_WALLET_PASSWORD=                # agent-wallet password — TWAK reads this env var itself
                                     # (preferred over a CLI flag). Keychain is used if empty.
WALLETCONNECT_PROJECT_ID=            # optional (WalletConnect mode)

# ── Agent identity (ERC-8004, written via TWAK) ───────────────────────────────
GRIDORA_AGENT_ADDRESS=               # your TWAK agent wallet address (0x…)
GRIDORA_AGENT_URI=ipfs://gridora-agent.json   # ERC-8004 registration file URI

# ── CoinMarketCap ──────────────────────────────────────────────────────────────
# Primary data path is keyless x402 via TWAK (`twak x402 request`). A CMC Pro key is
# OPTIONAL (direct pro-api fallback). The CMC Skill Hub MCP key is configured in your
# Claude Code MCP config, NOT here.
GRIDORA_CMC_API_KEY=                 # optional CMC Pro API key (pro.coinmarketcap.com)
GRIDORA_CMC_URL=https://pro-api.coinmarketcap.com

# ── Execution (TWAK-native) ────────────────────────────────────────────────────
GRIDORA_SWAP_FALLBACK=false          # false => maker limit orders (twak automate); true => taker swaps
GRIDORA_SLIPPAGE_PCT=0.5
GRIDORA_X402_MAX_PAYMENT=100000      # cap per CMC data call (atomic units of the x402 asset)

# ── Eligible tokens (the official 149) ─────────────────────────────────────────
GRIDORA_ALLOWLIST_FILE=allowlist.149.json   # run from backend/, or set an absolute path

# ── Risk caps (quote units; 0 = auto from preset). 30% drawdown = DQ — stay well under. ──
GRIDORA_PRESET=BALANCED              # SAFE | BALANCED | AGGRESSIVE
GRIDORA_QUOTE_MARGIN=100             # stablecoin to deploy
GRIDORA_MAX_DRAWDOWN=0               # 0 = auto (preset dd_frac × margin)
GRIDORA_MAX_INVENTORY=0
GRIDORA_ACCOUNT_DRAWDOWN=0
GRIDORA_RECENTER_INTERVAL_S=0

# ── Optional read-only verifier contracts (primary proof = TWAK ERC-8004) ──────
GRIDORA_IDENTITY_ADDR=
GRIDORA_JOURNAL_ADDR=
GRIDORA_LEDGER_ADDR=
GRIDORA_COMPETITION=0x212c61b9b72c95d95bf29cf032f5e5635629aed5
# forge deploy key for the OPTIONAL verifier contracts (separate from the TWAK agent
# wallet, which stays sealed in TWAK). Testnet throwaway; gitignored. Never reuse on mainnet.
DEPLOYER_PRIVATE_KEY=
